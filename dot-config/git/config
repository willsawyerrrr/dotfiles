[alias]
	# Commit aliases
	amend = commit --amend --no-edit
	empty = commit --allow-empty

	# Log aliases
	l = log --oneline

[commit]
	gpgsign = true

[core]
	editor = nvim
	excludesFile = "~/.config/git/ignore"
	pager = delta

[fetch]
	prune = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[include]
	# Machine-local list of repos registered for background maintenance
	path = ~/.config/git/maintenance

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[submodule]
	recurse = true

[tag]
	gpgSign = true

